# Halo — secret delle edge function in prod.
# Copia in supabase/.env.prod (gitignored) e riempi i valori reali, poi:
#   PROJECT_REF=<ref> ./scripts/deploy-supabase-prod.sh
#
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY sono iniettati automaticamente da
# Supabase nelle function: NON metterli qui.

# Apple StoreKit (App Store Connect → Users and Access → Integrations → In-App Purchase key)
APPLE_BUNDLE_ID=la.halo
APPLE_STOREKIT_ISSUER_ID=
APPLE_STOREKIT_KEY_ID=
APPLE_STOREKIT_PRIVATE_KEY=
# 0/1: consenti receipt locali StoreKit (solo per test, in prod lascia 0)
HALO_STOREKIT_ALLOW_LOCAL=0

# Stripe (Halo Events / Clubs)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=https://halo.la/checkout/success
STRIPE_CANCEL_URL=https://halo.la/checkout/cancel
STRIPE_PORTAL_RETURN_URL=https://halo.la/account

# Origine consentita per la landing (CORS waitlist-signup)
HALO_LANDING_ORIGIN=https://halo.la
# Bucket storage media
HALO_MEDIA_BUCKET=halo-media
